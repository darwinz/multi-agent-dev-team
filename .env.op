# 1Password references, resolved at runtime: op run --env-file=.env.op -- <cmd>
ANTHROPIC_API_KEY=op://Private/Anthropic Academy - API Key/credential
CODER_MODEL=anthropic:claude-haiku-5-5
PM_MODEL=anthropic:claude-sonnet-5-5
QA_MODEL=anthropic:claude-haiku-5-5
EXEC_TIMEOUT_SECONDS=10
CODER_MAX_ITERATIONS=10
QA_MAX_ITERATIONS=5
QA_MAX_TOKENS=16384
MEMORY_WINDOW_TURNS=10

# Resilience: retries (hard cap 3), circuit breakers, response cache (0 disables)
RETRY_MAX=3
RETRY_BASE_DELAY_S=1.0
RETRY_MAX_DELAY_S=30.0
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_S=30.0
CACHE_TTL_S=3600

# Logging and optional remote Chroma (leave CHROMA_HOST unset for the local store)
LOG_LEVEL=INFO
# CHROMA_HOST=localhost
CHROMA_PORT=8000
LANGSMITH_API_KEY=op://Private/LangSmith API key/credential
# LANGSMITH_TRACING=true
LANGSMITH_PROJECT=multi-agent-dev-team
