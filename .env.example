# Copy to .env and fill in. Never commit .env. docker compose reads it via env_file (optional).
ANTHROPIC_API_KEY=
CODER_MODEL=anthropic:claude-haiku-5-5
PM_MODEL=anthropic:claude-sonnet-5-5
QA_MODEL=anthropic:claude-haiku-5-5
EXEC_TIMEOUT_SECONDS=10
CODER_MAX_ITERATIONS=10
QA_MAX_ITERATIONS=5
QA_MAX_TOKENS=16384
MEMORY_WINDOW_TURNS=10

# Resilience: retries (hard cap 3), circuit breakers, response cache (0 disables)
RETRY_MAX=3
RETRY_BASE_DELAY_S=1.0
RETRY_MAX_DELAY_S=30.0
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_S=30.0
CACHE_TTL_S=3600

# Logging and optional remote Chroma (leave CHROMA_HOST empty for the local store;
# docker compose sets CHROMA_HOST=chroma and CHROMA_PORT=8000 itself)
LOG_LEVEL=INFO
CHROMA_HOST=
CHROMA_PORT=8000

# Alternative providers (install the matching extra: uv sync --extra openai / --extra ollama)
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Optional LangSmith tracing (set LANGSMITH_TRACING=true and a key to enable)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-dev-team
