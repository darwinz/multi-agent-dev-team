# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
CODER_MODEL=anthropic:claude-sonnet-5-5
EXEC_TIMEOUT_SECONDS=10
CODER_MAX_ITERATIONS=10
MEMORY_WINDOW_TURNS=10

# Alternative providers (install the matching extra: uv sync --extra openai / --extra ollama)
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multi-agent-dev-team
